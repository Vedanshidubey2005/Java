class Solution {
    public int maxScore(int[] cardPoints, int k) {
        int lsum= 0 , rsum =0 , maxS=0 , sum=0;
        for(int i = 0;i<= k-1;i++){
            lsum+= cardPoints[i];
        }
        maxS= lsum;
        int right= cardPoints.length -1;
        for( int i = k-1; i>=0;i--){
            lsum = lsum  - cardPoints[i];
            rsum = rsum + cardPoints[right];
            right--;
            maxS= Math.max(maxS, lsum+rsum);
        }
        return maxS;
        
    }
}
