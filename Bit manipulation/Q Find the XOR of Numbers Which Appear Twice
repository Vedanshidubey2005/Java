class Solution {
    public int duplicateNumbersXOR(int[] nums) {
        Arrays.sort(nums);
        int xor = 0;
        int count = 0;
        for(int i =0; i < nums.length ; i++){
        if((i < nums.length - 1 && nums[i] == nums[i+1]) || (i > 0 && nums[i-1] == nums[i])){
           count++;
        } 
        if(count == 2){
             xor = xor ^ nums[i];
             count =0;
        }
        }
        return xor;
    }
}
