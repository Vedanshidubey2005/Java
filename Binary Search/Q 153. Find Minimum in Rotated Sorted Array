class Solution {
    public int findMin(int[] nums) {
        int n = nums.length;
        int l=0 , h = n-1;
        int mini = Integer.MAX_VALUE;
        while(l <= h){
            int mid = l + (h-l)/2;
            if(nums[l]<= nums[mid]){
                mini = Math.min(mini, nums[l]);
                l=mid+1;
               // break;
            }
            else{
                mini = Math.min(mini, nums[mid]);
                h=mid-1;
            }
        }
        return mini;
    }
}
