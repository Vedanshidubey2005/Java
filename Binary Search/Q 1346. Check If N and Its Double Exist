class Solution {
    public boolean checkIfExist(int[] arr) {
         Arrays.sort(arr);
        int n = arr.length;
        for(int i =0; i<= n-1;i++){
            int target = 2* arr[i];
        int l =0,  h = n-1;
        while( l <= h){
            int mid = l+(h-l)/2;
            if(arr[mid]== target && mid != i) return true;
            else if(arr[mid] < target) l=mid+1;
            else h=mid-1;
        }
        }
        return false;
    }
}
