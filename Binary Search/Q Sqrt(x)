class Solution {
    public int mySqrt(int x) {
        int low=1;
        int high = x;
        long ans =1;
         if (x == 0) return 0;
        while( low<=high){
            long mid = low + (high -low) /2;
            long sq= mid*mid;
            if(sq <= x){
                ans = mid;
                low=(int)mid + 1;
            }
            else{
                high=(int)mid-1;
            }
        }
        return high;
    }
}
