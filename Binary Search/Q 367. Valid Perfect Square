class Solution {
    public boolean isPerfectSquare(int num) {
          int low=1;
        int high = num;
        long ans =1;
         if (num == 0) return false;
        while( low<=high){
            long mid = low + (high -low) /2;
            long sq= mid*mid;
            if ( sq == num) return true;
            else if(sq < num){
                ans = mid;
                low=(int)mid + 1;
            }
            else{
                high=(int)mid-1;
            }
        }
       
       return false;
    }
}
