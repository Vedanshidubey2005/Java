class Solution {
    public int arrangeCoins(int n) {
        int left = 1 , right = n;
         while( left <= right){
            long mid = left + (right - left)/2;
            long ans = mid *(mid+1)/2;
            if( ans == n) return(int) mid;
            else if( ans < n) left =(int) mid + 1;
            else right = (int) mid - 1;
         }
         return right;
    }
}
