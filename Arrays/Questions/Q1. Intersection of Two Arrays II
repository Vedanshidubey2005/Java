class Solution {
    public int[] intersect(int[] nums1, int[] nums2) {
        int m = nums1.length;
        int n = nums2.length;
         Arrays.sort(nums1);
         Arrays.sort(nums2);
        int l=0, r = 0;
       // int r = 0;
    ArrayList<Integer> ans = new ArrayList<>();
        while( l< m && r < n){
   
            if(nums1[l]< nums2[r]){
                l++;
            }
            else if( nums1[l] > nums2[r]){
                r++;
            }
            else{
             // if (ans.isEmpty() || ans.get(ans.size() - 1) != nums1[l])  {
                    ans.add(nums1[l]);
             // }
                l++;
                r++;
            }
        }
int[] result = new int[ans.size()];
        for (int i = 0; i < ans.size(); i++) {
            result[i] = ans.get(i);
        }
        return result;
    }
}
